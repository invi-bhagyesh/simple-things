    "from tqdm import tqdm\n",
    "correct =0\n",
    "total=0\n",
    "invalid=0\n",
    "for i in tqdm(val_set):\n",
    "    prompt = prompt_transform(i)\n",
    "    correct_label = i[\"answerKey\"]\n",
    "    labels = i[\"choices\"][\"label\"]\n",
    "\n",
    "    prediction_text = model_answer(prompt)\n",
    "    pred = extract_letter(prediction_text, labels)\n",
    "\n",
    "    if pred is None:\n",
    "        invalid+=1\n",
    "    else:\n",
    "        total+=1\n",
    "        if pred == correct_label:\n",
    "            correct+=1\n",
    "    "
   ]
  },
