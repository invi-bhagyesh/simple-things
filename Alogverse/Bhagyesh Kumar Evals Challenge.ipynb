   "source": [
    "### Part B: Calibration Analysis using Brier Score\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d6d7cfae",
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "MODEL_NAME = \"ft:gpt-4.1-nano-2025-04-14:algoverse-ai-safety:arc-v2:CrBuBGfj\"\n",
    "\n",
    "def model_bier(prompt):\n",
    "    response = client.responses.create(\n",
    "        model= MODEL_NAME,\n",
    "        input=prompt,\n",
    "        temperature=0,\n",
    "        include=[\"message.output_text.logprobs\"]\n",
    "    )\n",
    "    pp.pprint(response)\n",
    "    output = response.output[0]\n",
    "    text = output.content[0].text.strip()\n",
    "    logprobs = output.content[0].logprobs[0].logprob\n",
    "\n",
    "    if not logprobs or logprobs[0] is None:\n",
    "        conf = 0\n",
    "    else:\n",
    "        conf = math.exp(logprobs[0])\n",
    "\n",
    "    return text, conf\n",
    "\n",
    "    "
   ]
