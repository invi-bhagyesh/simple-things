    "def model_answer(prompt):\n",
    "    response = client.responses.create(\n",
    "        model=\"ft:gpt-4.1-nano-2025-04-14:algoverse-ai-safety:arc-v2:CrBuBGfj\",\n",
    "        input = prompt,\n",
    "        temperature = 0,\n",
    "    )\n",
    "    return response.output_text.strip()"
   ]
