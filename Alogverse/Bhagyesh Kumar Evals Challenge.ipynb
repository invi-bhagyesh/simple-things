   "outputs": [],
   "source": [
    "import re\n",
    "def extract_letter(text, valid_label):\n",
    "    check = re.search(r\"\\b([A-Z])\\b\", text)\n",
    "    if check:\n",
    "        letter = check.group(1)\n",
    "        if letter in valid_label:\n",
    "            return letter\n",
    "    return None"
   ]
  },
