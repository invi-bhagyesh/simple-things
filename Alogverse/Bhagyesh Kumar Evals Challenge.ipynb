    "def prompt_transform(prompt):\n",
    "    question = prompt[\"question\"]\n",
    "    labels = prompt[\"choices\"][\"label\"]\n",
    "    texts = prompt[\"choices\"][\"text\"]\n",
    "\n",
    "    lines = [question.strip(), \"\"]\n",
    "    for label, text in zip(labels, texts):\n",
    "        lines.append(f\"{label}. {text.strip()}\")\n",
    "    return \"\\n\".join(lines)\n",
    "    "
   ]
  },
